---
layout: layout.njk
title: Réservation Local Blanc
---

<div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-green-900 mb-4 border-b-4 border-green-700 pb-2 inline-block">Le Local Blanc</h1>
    
    <p class="text-gray-600 mb-8 max-w-2xl">Située au cœur du quartier, non loin de l'église, notre local est disponible pour vos événements familiaux, réunions ou activités associatives.</p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-gray-100 p-6 rounded-2xl border-l-4 border-green-700">
                <h3 class="font-bold text-lg mb-2">Modalités de location :</h3>
                <ul class="list-disc list-inside text-gray-700 space-y-1">
                    <li>Location (àpd 8h) par demi-journée (max 5h), journée (max 23h) et soirée (de 17h30 à 23h).</li>
                    <li>Avoir lu, accepté et signé le Règlement d'ordre intérieur</li>
                    <li>Avoir lu, complété et signé la convention de location</li>
                </ul>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto my-8 px-4">
                    <button class="open-pdf-btn bg-green-700 hover:bg-green-800 text-white font-bold py-3 px-4 rounded-lg shadow-md transition duration-300 flex items-center justify-center transform hover:-translate-y-0.5"
                        data-pdf="/assets/pdf/Tarif du Local blanc du Petit-Ry - 2026.pdf" 
                        data-title="Tarifs du Local Blanc">
                        📄 Tarifs du Local Blanc
                    </button>

                    <button class="open-pdf-btn bg-green-700 hover:bg-green-800 text-white font-bold py-3 px-4 rounded-lg shadow-md transition duration-300 flex items-center justify-center transform hover:-translate-y-0.5"
                        data-pdf="/assets/pdf/Convention d'occupation du Local blanc du Petit-Ry.pdf" 
                        data-title="Convention de location">
                        ✍️ La Convention
                    </button>

                    <button class="open-pdf-btn bg-green-700 hover:bg-green-800 text-white font-bold py-3 px-4 rounded-lg shadow-md transition duration-300 flex items-center justify-center transform hover:-translate-y-0.5"
                        data-pdf="/assets/pdf/ROI- local blanc du Petit-Ry.pdf" 
                        data-title="Règlement d'Ordre Intérieur (ROI)">
                        📜 Le R.O.I.
                    </button>
                </div>
                
                <p class="text-sm text-gray-500 mt-4 italic">* Les tarifs et conditions sont envoyés par email après avoir fait la demande de réservation.</p>
            </div>

            <div class="bg-white p-2 rounded-xl shadow-inner border border-gray-200">
                <iframe src="https://calendar.google.com/calendar/embed?src=localblancpetitry%40gmail.com&ctz=Europe%2FBrussels&mode=MONTH&showTitle=0&showPrint=0&showTabs=1&showCalendars=0" 
                        style="border: 0" width="100%" height="500" frameborder="0" scrolling="no" class="rounded-lg">
                </iframe>
                <p class="text-xs text-gray-400 mt-2 italic text-center">Les plages grisées indiquent que la salle est déjà réservée.</p>
            </div>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 italic">Demander une réservation</h2>
            
            <form action="https://formsubmit.co/localblancpetitry@gmail.com" method="POST" class="space-y-4">
                <input type="hidden" name="_captcha" value="false">
                <input type="text" name="_honey" style="display:none">
                <input type="hidden" name="_template" value="table">
                <input type="hidden" name="_subject" value="Nouvelle demande Local Blanc">

                <div>
                    <label class="block text-sm font-medium">Votre Nom, Prénom</label>
                    <input type="text" name="name" required class="w-full mt-1 p-3 bg-gray-50 border rounded-lg focus:ring-green-500 focus:border-green-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Type d'événement</label>
                    <select id="event-type" name="type_evenement" class="w-full p-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-green-500 focus:outline-none">
                        <option value="Anniversaire">Anniversaire / Fête famille</option>
                        <option value="Réunion">Réunion associative</option>
                        <option value="Autre">Autre (préciser...)</option>
                    </select>
                </div>

                <div id="precision-block" class="hidden mt-4">
                    <label class="block text-xs font-bold text-orange-600 uppercase mb-2">Veuillez préciser :</label>
                    <input type="text" name="precision_autre" placeholder="Ex: Exposition, cours de yoga..." class="w-full p-3 bg-orange-50 border-2 border-orange-100 rounded-xl focus:border-orange-500 focus:outline-none transition">
                </div>

                <div>
                    <label class="block text-sm font-medium">Date souhaitée</label>
                    <input type="date" name="date_souhaitee" required class="w-full mt-1 p-3 bg-gray-50 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-medium">Durée</label>
                    <div class="mt-2 space-y-2">
                        <label class="inline-flex items-center"><input type="radio" name="duree" value="Demi-journée 8h 13h" checked class="text-green-600"> <span class="ml-2">Demi-journée (8h à 13h)</span></label><br>
                        <label class="inline-flex items-center"><input type="radio" name="duree" value="Demi-journée 14h 19h" class="text-green-600"> <span class="ml-2">Demi-journée (14h à 19h)</span></label><br>
                        <label class="inline-flex items-center"><input type="radio" name="duree" value="Soirée 17h30 23h" class="text-green-600"> <span class="ml-2">Soirée (17h30 à 23h)</span></label><br>
                        <label class="inline-flex items-center"><input type="radio" name="duree" value="Journée complète 8h 23h" class="text-green-600"> <span class="ml-2">Journée complète (8h à 23h)</span></label>
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full bg-orange-500 text-white font-bold py-3 px-6 rounded-lg hover:bg-orange-600 transition shadow-md">
                        Envoyer la demande
                    </button>
                    <p class="text-[10px] text-gray-400 mt-4 text-center italic">Cette demande ne vaut pas une réservation définitive. Le comité vous recontactera.</p>
                </div>
            </form>
        </div>

    </div>
</div>

<div id="pdfModal" class="hidden fixed inset-0 bg-black bg-opacity-70 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-4xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
        
        <div class="p-4 border-b flex justify-between items-center bg-gray-50">
            <h3 id="modalTitle" class="font-bold text-gray-800 text-lg">Document</h3>
            <button id="closePdfBtn" class="text-gray-400 hover:text-gray-600 text-3xl font-light leading-none p-2">&times;</button>
        </div>
        
        <div class="flex-grow bg-gray-100">
            <iframe id="modalIframe" src="" class="w-full h-full border-none"></iframe>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    
    // 1. GESTION DU FORMULAIRE (Bloc Précision "Autre")
    const eventSelect = document.getElementById('event-type');
    const precisionBlock = document.getElementById('precision-block');

    if (eventSelect && precisionBlock) {
        eventSelect.addEventListener('change', function() {
            if (this.value === 'Autre') {
                precisionBlock.classList.remove('hidden');
            } else {
                precisionBlock.classList.add('hidden');
            }
        });
    }

    // 2. GESTION DES BOUTONS MULTI-PDF
    const pdfButtons = document.querySelectorAll('.open-pdf-btn');
    const modal = document.getElementById('pdfModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalIframe = document.getElementById('modalIframe');
    const closeBtn = document.getElementById('closePdfBtn');

    // On écoute le clic sur CHAQUE bouton avec la classe
    pdfButtons.forEach(button => {
        button.addEventListener('click', () => {
            const pdfUrl = button.getAttribute('data-pdf');
            const title = button.getAttribute('data-title');

            // On injecte dynamiquement les données du bouton dans la modale
            modalIframe.src = pdfUrl;
            modalTitle.textContent = title;

            // On affiche la modale
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Empêche de scroller la page arrière
        });
    });

    // Fonction de fermeture
    function closeModal() {
        modal.classList.add('hidden');
        modalIframe.src = ""; // Coupe le chargement du PDF
        document.body.style.overflow = ''; // Relance le scroll
    }

    // Fermeture via le bouton X
    if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
    }

    // Fermeture via un clic à l'extérieur de la boîte blanche
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    }
});
</script>