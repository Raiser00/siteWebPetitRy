---
layout: layout.njk
title: Activités du Local Blanc
---

<div class="container mx-auto px-4 py-12">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold text-green-900 mb-3">Activités et cours du Local Blanc</h1>
        <p class="text-gray-600 italic">Découvrez toutes les activités et cours proposés au cœur de notre quartier.</p>
    </div>

    <!-- GRILLE DES ACTIVITÉS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for activite in collections.activites %}
            <!-- Carte entière cliquable -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100 flex flex-col cursor-pointer hover:shadow-xl hover:-translate-y-1 transition duration-300 group justify-between"
                 onclick="openActiviteModal(this)"
                 data-title="{{ activite.data.title }}"
                 data-horaire="{{ activite.data.horaire }}"
                 data-image="{{ activite.data.image }}">
                
                <div>
                    <!-- Photo -->
                    {% if activite.data.image %}
                        <img src="{{ activite.data.image }}" class="h-48 w-full object-cover group-hover:scale-105 transition duration-500">
                    {% else %}
                        <div class="h-48 w-full bg-green-100 flex items-center justify-center">
                            <span class="text-green-500 text-5xl">🧘</span>
                        </div>
                    {% endif %}

                    <div class="p-6">
                        <!-- Badge Horaire -->
                        {% if activite.data.horaire %}
                        <span class="inline-block px-3 py-1 bg-orange-500 text-white text-xs font-bold rounded-full mb-3 shadow-sm">
                            🕒 {{ activite.data.horaire }}
                        </span>
                        {% endif %}
                        
                        <h3 class="text-2xl font-bold text-gray-800 mb-3 group-hover:text-green-800 transition">{{ activite.data.title }}</h3>
                        
                        <!-- Aperçu tronqué -->
                        <div class="prose prose-sm text-gray-500 line-clamp-3 mb-4">
                            {{ activite.templateContent | safe }}
                        </div>
                    </div>
                </div>

                <!-- Bouton en savoir plus -->
                <div class="px-6 pb-6 pt-2 flex justify-between items-center mt-auto">
                    <span class="text-orange-600 font-bold text-xs uppercase tracking-wider group-hover:text-orange-700">En savoir plus →</span>
                </div>

                <!-- Source HTML cachée pour le modal -->
                <div class="hidden full-description-source">
                    {{ activite.templateContent | safe }}
                </div>
            </div>
        {% else %}
        <div class="col-span-full text-center py-16 bg-gray-50 rounded-3xl border border-dashed border-gray-300">
            <p class="text-gray-500 text-lg">Aucune activité enregistrée pour le moment. Revenez bientôt !</p>
        </div>
        {% endfor %}
    </div>

    <!-- BOUTON RETOUR -->
    <div class="text-center mt-16">
        <a href="/" class="inline-flex items-center gap-2 bg-green-800 hover:bg-green-900 text-white font-bold px-6 py-3 rounded-xl transition shadow-md">
            &larr; Retour à l'accueil
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- 🪐 LA BOÎTE MODAL (DÉTAILS ACTIVITÉ)       -->
<!-- ========================================== -->
<div id="activite-modal" class="fixed inset-0 bg-black/70 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm" onclick="closeActiviteModal()">
    <div class="bg-white rounded-3xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl relative" onclick="event.stopPropagation()">
        
        <!-- Bouton Fermer -->
        <button onclick="closeActiviteModal()" class="absolute top-4 right-4 bg-white/80 hover:bg-white text-gray-800 w-10 h-10 rounded-full flex items-center justify-center text-2xl transition z-10 shadow-md">&times;</button>
        
        <!-- Image de la modale -->
        <div class="w-full bg-slate-900 flex items-center justify-center relative min-h-[250px] max-h-[75vh] overflow-hidden">
            <img id="modal-img" src="" class="w-full max-h-[75vh] object-contain mx-auto">
            <div id="modal-placeholder" class="w-full h-64 bg-green-100 flex items-center justify-center hidden">
                <span class="text-green-500 text-6xl">🧘</span>
            </div>
        </div>

        <!-- Contenu de la modale -->
        <div class="p-8">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <!-- Badge horaire dans le modal -->
                <span id="modal-horaire" class="bg-orange-50 text-orange-700 px-4 py-2 rounded-full font-bold text-sm hidden"></span>
            </div>

            <!-- Titre -->
            <h2 id="modal-title" class="text-3xl font-black text-gray-900 mb-6 leading-tight"></h2>

            <!-- Description complète -->
            <div id="modal-body" class="prose prose-green max-w-none text-gray-600 border-t border-gray-100 pt-6">
                <!-- Injecté par JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 📜 LE SCRIPT POUR ALIMENTER LA MODAL       -->
<!-- ========================================== -->
<script>
    function openActiviteModal(card) {
        const modal = document.getElementById('activite-modal');
        const modalImg = document.getElementById('modal-img');
        const modalPlaceholder = document.getElementById('modal-placeholder');
        const modalTitle = document.getElementById('modal-title');
        const modalHoraire = document.getElementById('modal-horaire');
        const modalBody = document.getElementById('modal-body');

        // Récupération des attributs de la carte
        const title = card.getAttribute('data-title');
        const horaire = card.getAttribute('data-horaire');
        const image = card.getAttribute('data-image');
        
        // Récupération du contenu HTML complet
        const fullDescriptionHtml = card.querySelector('.full-description-source').innerHTML;

        // Injection des valeurs
        modalTitle.innerText = title;
        
        if (horaire && horaire !== "null" && horaire !== "") {
            modalHoraire.innerText = "🕒 " + horaire;
            modalHoraire.classList.remove('hidden');
        } else {
            modalHoraire.classList.add('hidden');
        }

        modalBody.innerHTML = fullDescriptionHtml;

        // Gestion de l'image
        if (image && image !== "null" && image !== "undefined" && image !== "") {
            modalImg.src = image;
            modalImg.classList.remove('hidden');
            modalPlaceholder.classList.add('hidden');
        } else {
            modalImg.classList.add('hidden');
            modalPlaceholder.classList.remove('hidden');
        }

        // Affichage de la modale
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeActiviteModal() {
        const modal = document.getElementById('activite-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeActiviteModal();
    });
</script>