---
layout: layout.njk
title: La Gazette du Petit-Ry
---

<div class="container mx-auto px-4 py-12">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-green-900 mb-4">La Gazette du Petit-Ry</h1>
        <p class="text-gray-600">Retrouvez toutes les éditions mensuelles de notre quartier.</p>
    </div>

    <!-- Sélecteur d'édition -->
    <div class="max-w-md mx-auto mb-6">
        <label for="gazette-select" class="block text-sm font-medium text-gray-700 mb-2">Choisir une édition :</label>
        <select id="gazette-select" class="w-full p-3 border-2 border-green-700 rounded-xl focus:ring-green-500 focus:border-green-500 bg-white">
            {% for g in collections.gazette | reverse %}
                {% if g.data.file %}
                    <option value="{{ g.data.file }}">{{ g.data.title }} ({{ g.date | formatDate }})</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>

    <!-- Boutons d'action -->
    <div class="flex flex-wrap justify-center gap-4 mb-6">
        <button id="fullscreen-btn" class="bg-green-800 text-white px-5 py-2.5 rounded-full hover:bg-green-700 transition flex items-center shadow">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
            Plein écran
        </button>

        <!-- Bouton ouvrir / télécharger -->
        <a id="download-btn" href="#" target="_blank" rel="noopener" class="bg-orange-500 text-white px-5 py-2.5 rounded-full hover:bg-orange-600 transition flex items-center shadow">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            Ouvrir / Télécharger le PDF
        </a>
    </div>

    <!-- Visionneuse PDF -->
    <div class="bg-gray-200 rounded-3xl p-2 md:p-6 shadow-inner min-h-[600px] flex flex-col items-center">
        <div id="pdf-container" class="w-full h-[700px] bg-white rounded-xl shadow-xl overflow-hidden relative">
            <iframe id="pdf-viewer" src="" class="w-full h-full" frameborder="0"></iframe>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const select = document.getElementById('gazette-select');
        const viewer = document.getElementById('pdf-viewer');
        const fullBtn = document.getElementById('fullscreen-btn');
        const downloadBtn = document.getElementById('download-btn');

        function updateViewer() {
            if (!select || select.options.length === 0) return;
            
            let pdfUrl = select.value.trim();
            if (!pdfUrl) return;
            
            // S'assurer que le chemin commence TOUJOURS par un '/'
            if (!pdfUrl.startsWith('/') && !pdfUrl.startsWith('http')) {
                pdfUrl = '/' + pdfUrl;
            }

            // Mise à jour de l'iframe et du bouton de téléchargement
            viewer.src = pdfUrl + "#toolbar=0&navpanes=0";
            downloadBtn.href = pdfUrl;
        }

        if (select) {
            select.addEventListener('change', updateViewer);
            updateViewer();
        }

        if (fullBtn && viewer) {
            fullBtn.addEventListener('click', () => {
                const currentUrl = downloadBtn.href;
                if (currentUrl && currentUrl !== '#') {
                    window.open(currentUrl, '_blank');
                }
            });
        }
    });
</script>