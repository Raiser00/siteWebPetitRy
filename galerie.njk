---
layout: layout.njk
title: Galerie
---

<div class="container mx-auto px-4 py-12">
    <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-green-900 mb-3">Souvenirs du Petit-Ry</h1>
        <p class="text-gray-600 italic">Revivez les moments forts de notre quartier.</p>
    </div>

    <!-- 1. BOUTONS DE FILTRES DYNAMIQUES -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-buttons">
        <button onclick="showAlbum('all')" data-filter="all" class="filter-btn active px-5 py-2 rounded-full border-2 border-green-800 bg-green-800 text-white font-bold transition shadow-sm hover:opacity-90">
            Tous les albums
        </button>
        
        {% for album in collections.galerie %}
        {% set safeSlug = (album.data.slug or album.fileSlug) | slugify %}
        <button onclick="showAlbum('{{ safeSlug }}')" data-filter="{{ safeSlug }}" class="filter-btn px-5 py-2 rounded-full border-2 border-orange-500 text-orange-600 font-bold hover:bg-orange-500 hover:text-white transition shadow-sm">
            {{ album.data.title }}
        </button>
        {% endfor %}
    </div>

    <!-- 2. VUE "TOUS" : GRILLE DE CARTES D'ALBUMS -->
    <div id="albums-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {% for album in collections.galerie %}
        {% set safeSlug = (album.data.slug or album.fileSlug) | slugify %}
        {% set coverImage = album.data.image if album.data.image else (album.data.photos[0].image if album.data.photos and album.data.photos.length > 0 else '/assets/img/placeholder.jpg') %}
        
        <div onclick="showAlbum('{{ safeSlug }}')" class="group cursor-pointer bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition duration-300 transform hover:-translate-y-1 border border-gray-100 flex flex-col">
            <div class="relative h-56 overflow-hidden bg-gray-200">
                <img src="{{ coverImage }}" alt="{{ album.data.title }}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-80 group-hover:opacity-90 transition"></div>
                <div class="absolute bottom-3 left-4 right-4 flex justify-between items-end text-white">
                    <span class="bg-orange-500/90 backdrop-blur-sm text-xs font-semibold px-2.5 py-1 rounded-full">
                        {{ album.data.photos | length if album.data.photos else 0 }} photo{% if album.data.photos and album.data.photos.length > 1 %}s{% endif %}
                    </span>
                    {% if album.data.date %}
                    <span class="text-xs text-gray-200">{{ album.data.date | formatDate }}</span>
                    {% endif %}
                </div>
            </div>
            <div class="p-5 flex-grow flex flex-col justify-between">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 group-hover:text-green-800 transition mb-2">{{ album.data.title }}</h3>
                    {% if album.data.body %}
                    <p class="text-gray-600 text-sm line-clamp-2">{{ album.data.body }}</p>
                    {% endif %}
                </div>
                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-orange-600 font-bold text-sm group-hover:translate-x-1 transition">
                    Voir les photos <span class="ml-1">&rarr;</span>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- 3. VUES ALBUMS SPÉCIFIQUES (GRILLES DE PHOTOS) -->
    <div id="albums-photos-container">
        {% for album in collections.galerie %}
        {% set safeSlug = (album.data.slug or album.fileSlug) | slugify %}
        <section data-album="{{ safeSlug }}" class="album-section hidden mb-16">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-4 border-b-2 border-orange-500">
                <div>
                    <h2 class="text-3xl font-extrabold text-gray-800">📸 {{ album.data.title }}</h2>
                    {% if album.data.body %}
                    <p class="text-gray-600 mt-1">{{ album.data.body }}</p>
                    {% endif %}
                </div>
                <button onclick="showAlbum('all')" class="self-start sm:self-auto bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-xl text-sm font-bold transition flex items-center gap-2">
                    &larr; Tous les albums
                </button>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {% if album.data.photos and album.data.photos.length > 0 %}
                    {% for photo in album.data.photos %}
                    <div class="group relative cursor-pointer overflow-hidden rounded-xl shadow-md hover:shadow-xl h-64 bg-gray-200 transition" onclick="openLightbox(this)">
                        <img src="{{ photo.image }}" alt="{{ photo.alt or album.data.title }}" class="w-full h-full object-cover transform group-hover:scale-105 transition duration-500">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all flex items-center justify-center">
                            <span class="text-white text-3xl font-light opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 w-12 h-12 rounded-full flex items-center justify-center">+</span>
                        </div>
                        {% if photo.alt %}
                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-3 text-white text-xs truncate opacity-0 group-hover:opacity-100 transition">
                            {{ photo.alt }}
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                {% else %}
                    <p class="col-span-full text-center py-12 text-gray-500 italic bg-gray-50 rounded-2xl">Aucune photo dans cet album pour le moment.</p>
                {% endif %}
            </div>
        </section>
        {% endfor %}
    </div>
</div>

<!-- LIGHTBOX -->
<div id="lightbox" class="fixed inset-0 bg-black/95 z-[100] hidden flex-col items-center justify-center p-4 backdrop-blur-sm" onclick="closeLightbox()">
    <button class="absolute top-6 right-8 text-white text-5xl font-light hover:text-orange-500 transition">&times;</button>
    <img id="lightbox-img" src="" class="max-w-full max-h-[80vh] rounded-lg shadow-2xl border border-white/20" onclick="event.stopPropagation()">
    <p id="lightbox-caption" class="text-white mt-6 text-xl font-medium tracking-wide italic text-center max-w-2xl"></p>
</div>

<!-- SCRIPTS -->
<script>
    function showAlbum(targetSlug) {
        const cardsGrid = document.getElementById('albums-cards-grid');
        const sections = document.querySelectorAll('.album-section');
        const buttons = document.querySelectorAll('.filter-btn');

        // 1. Mise à jour du style des boutons
        buttons.forEach(btn => {
            const filterValue = btn.getAttribute('data-filter');
            if (filterValue === targetSlug) {
                btn.classList.add('bg-green-800', 'text-white', 'border-green-800');
                btn.classList.remove('text-orange-600', 'border-orange-500', 'text-green-800');
            } else {
                btn.classList.remove('bg-green-800', 'text-white');
                if (filterValue === 'all') {
                    btn.classList.add('border-green-800', 'text-green-800');
                } else {
                    btn.classList.add('text-orange-600', 'border-orange-500');
                }
            }
        });

        // 2. Basculement entre la vue Cartes d'Albums et la vue Photos
        if (targetSlug === 'all') {
            cardsGrid.classList.remove('hidden');
            cardsGrid.classList.add('grid');
            sections.forEach(sec => sec.classList.add('hidden'));
        } else {
            cardsGrid.classList.add('hidden');
            cardsGrid.classList.remove('grid');
            
            sections.forEach(sec => {
                if (sec.getAttribute('data-album') === targetSlug) {
                    sec.classList.remove('hidden');
                } else {
                    sec.classList.add('hidden');
                }
            });
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Lightbox
    function openLightbox(el) {
        const img = el.querySelector('img');
        const modal = document.getElementById('lightbox');
        const modalImg = document.getElementById('lightbox-img');
        const modalCaption = document.getElementById('lightbox-caption');

        modalImg.src = img.src;
        modalCaption.innerText = img.alt || '';
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const modal = document.getElementById('lightbox');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
    });
</script>